# All secrets must be configured locally; NEVER commit real values.
# Optional: live NVIDIA model calls not verified in V0.2
NVIDIA_API_KEY=
NVIDIA_MODEL=
# Optional: real openFDA API requests; obtain a free key if needed
OPENFDA_API_KEY=
# Optional: database location; default is local backend/demo.db
# FOODRECALL_DB=C:\\Projects\\foodrecall-ai\\data\\local.db

# V0.3 AI orchestration: NVIDIA direct or Meterless openai-compatible gateway
# NOTE: NVIDIA_API_KEY and NVIDIA_MODEL are required for real tool selection.
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
FOODRECALL_MODEL_PROVIDER=nvidia
# For Meterless instead, provide the exact gateway base URL and supported model ID:
METERLESS_BASE_URL=
METERLESS_API_KEY=
METERLESS_MODEL=
# Zetaris: supply the REAL tenant URL and exact OpenSqlQuery Postman endpoint path
ZETARIS_URL=
ZETARIS_ID_TOKEN=
ZETARIS_QUERY_PATH=
ZETARIS_RECALL_TABLE=
ZETARIS_SHIPMENT_TABLE=

# V0.4 first-launch local QA/analyst accounts. For unattended setup only;
# never commit a real password, use environment variables in your own terminal.
FOODRECALL_BOOTSTRAP_PASSWORD=
FOODRECALL_ANALYST_PASSWORD=
# v0.6: This archive contains NO sponsor secrets and NO real data.
# Run: python scripts/preflight.py (local, no provider traffic).
# Then explicitly: python scripts/preflight.py --live --output verification/PREFLIGHT_LIVE_LOCAL.json
# Keep your real configuration in your operating-system environment, never ZIP/GitHub.

# V0.8 optional PUBLIC SYNTHETIC DEMO ONLY. This is NOT production authorization.
# Enable ONLY after configuring HTTPS on your host and both private passwords.
# With 0/absent, private API is loopback-only even if a container listens publicly.
FOODRECALL_DEMO_REMOTE=0
FOODRECALL_PUBLIC_ORIGIN=
# Passwords (minimum 16 chars) must be set in the host's private settings.
# Demo uses local SQLite; ephemeral PaaS filesystems reset data on redeploy.
